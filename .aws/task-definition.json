{
  "family": "ai-job-portal-web",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ai-job-portal-ecs-execution",
  "containerDefinitions": [
    {
      "name": "web",
      "image": "replaced-by-github-actions",
      "essential": true,
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "environment": [
        { "name": "NGINX_RESOLVER", "value": "169.254.169.253" },
        { "name": "API_UPSTREAM", "value": "http://api.ai-job-portal.local:4000" },
        { "name": "CSP_CONNECT_SRC", "value": "'self'" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ai-job-portal-web",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "web",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
