# API base URL. Leave empty to use same-origin /api (Vite dev proxy locally, nginx/ALB in production).
VITE_API_URL=
# Product name shown in the header and page title.
VITE_APP_NAME=HireLens
# Dev only: where the Vite dev server proxies /api (default http://localhost:4000).
VITE_API_PROXY=http://localhost:4000
